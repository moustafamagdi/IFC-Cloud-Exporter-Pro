<Window x:Class="ACCIFCConverter.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ACC IFC Converter Pro" Height="780" Width="1280" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="#1F2937" Padding="20">
            <TextBlock Text="ACC IFC Converter Pro" Foreground="White" FontWeight="Bold" FontSize="18" Margin="0,0,0,20"/>
            <Button Content="Dashboard" Command="{Binding ShowDashboardCommand}" Margin="0,0,0,8"/>
            <Button Content="Projects Browser" Command="{Binding ShowBrowserCommand}" Margin="0,0,0,8"/>
            <Button Content="Export Queue" Command="{Binding ShowQueueCommand}" Margin="0,0,0,8"/>
            <Button Content="History" Command="{Binding ShowHistoryCommand}" Margin="0,0,0,8"/>
            <Button Content="Settings" Command="{Binding ShowSettingsCommand}" Margin="0,0,0,8"/>
            <Button Content="About" Command="{Binding ShowAboutCommand}" Margin="0,0,0,8"/>
        </StackPanel>

        <DockPanel Grid.Column="1" Margin="16">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button Content="Login ACC" Command="{Binding LoginCommand}" Margin="0,0,8,0"/>
                <Button Content="Logout" Command="{Binding LogoutCommand}" Margin="0,0,8,0"/>
                <Button Content="Refresh Browser" Command="{Binding LoadBrowserAsyncCommand}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center"/>
            </StackPanel>

            <TabControl>
                <TabItem Header="Dashboard">
                    <StackPanel Margin="12">
                        <TextBlock Text="Welcome to ACC IFC Converter Pro" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Margin="0,8,0,0" Text="Use Projects Browser to select RVT files, add jobs into queue, then process and monitor history."/>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Projects Browser">
                    <Grid Margin="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2" Margin="0,0,0,8">
                            <TextBlock Text="Search RVT:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Width="250" Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                            <Button Content="Apply Search" Command="{Binding LoadBrowserAsyncCommand}"/>
                        </StackPanel>

                        <TreeView Grid.Row="1" ItemsSource="{Binding BrowserNodes}">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="IFC Preset" FontWeight="Bold"/>
                            <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"/>

                            <TextBlock Margin="0,12,0,0" Text="Output Naming Template" FontWeight="Bold"/>
                            <TextBox Text="{Binding NamingTemplate, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="Preview:" FontWeight="Bold" Margin="0,12,0,0"/>
                            <TextBlock Text="{Binding OutputPreview}" TextWrapping="Wrap"/>

                            <Button Content="Add Sample Queue Job" Command="{Binding AddSampleJobCommand}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Export Queue">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="8">
                            <Button Content="Process Queue" Command="{Binding ProcessQueueCommand}" Margin="0,0,8,0"/>
                            <Button Content="Add Sample Job" Command="{Binding AddSampleJobCommand}"/>
                        </StackPanel>
                        <DataGrid ItemsSource="{Binding Jobs}" AutoGenerateColumns="False" IsReadOnly="True" Margin="8">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Model" Binding="{Binding SourceFileName}" Width="2*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}"/>
                                <DataGridTextColumn Header="Output" Binding="{Binding ResultUrl}" Width="2*"/>
                                <DataGridTextColumn Header="Error" Binding="{Binding ErrorMessage}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>

                <TabItem Header="History">
                    <DataGrid ItemsSource="{Binding History}" AutoGenerateColumns="False" IsReadOnly="True" Margin="8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="2*"/>
                            <DataGridTextColumn Header="Date" Binding="{Binding EndUtc}" Width="*"/>
                            <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="*"/>
                            <DataGridTextColumn Header="Output" Binding="{Binding OutputPath}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="Scheduler">
                    <Grid Margin="12">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Cadence:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox Width="120" ItemsSource="{Binding Cadences}" SelectedItem="{Binding SelectedCadence}" Margin="0,0,8,0"/>
                            <Button Content="Schedule Export" Command="{Binding ScheduleExportCommand}"/>
                        </StackPanel>
                        <DataGrid Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding ScheduledJobs}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="Cadence" Binding="{Binding Cadence}" Width="*"/>
                                <DataGridTextColumn Header="Arguments" Binding="{Binding Arguments}" Width="2*"/>
                                <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Settings">
                    <StackPanel Margin="12">
                        <TextBlock Text="APS Client ID"/><TextBox Text="{Binding Settings.ApsClientId}"/>
                        <TextBlock Text="APS Client Secret" Margin="0,8,0,0"/><TextBox Text="{Binding Settings.ApsClientSecret}"/>
                        <TextBlock Text="Callback URL" Margin="0,8,0,0"/><TextBox Text="{Binding Settings.ApsCallbackUrl}"/>
                        <TextBlock Text="Default Output Folder" Margin="0,8,0,0"/><TextBox Text="{Binding Settings.DefaultOutputFolder}"/>
                        <TextBlock Text="Retry Count" Margin="0,8,0,0"/><TextBox Text="{Binding Settings.RetryCount}"/>
                        <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}" Margin="0,12,0,0" Width="140"/>
                    </StackPanel>
                </TabItem>

                <TabItem Header="About">
                    <TextBlock Text="ACC IFC Converter Pro v1.1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</Window>
